    <!-- Header -->
    <header class="w3-container w3-red w3-center"
        style="background-image: url(/images/user/21481.jpg);">


        <a href="/products">
            <div class="blurry-background m-3">
                <h1 class="m-0 p-0 w3-jumbo times-font">PAINTCONT</h1>
                <p class="m-0 p-0 w3-xlarge">Premium || Vibrant || Reliable</p>
            </div>
        </a>

    </header>


    <!-- First Grid -->
    <div class="w3-row-padding w3-padding-64 w3-container text-center">
        <h1>"Unleash Your Creativity with Every Can of Paint."</h1>
    </div>



    <section class="container px-3 mb-5">
        <div class="bg-danger mx-auto text-center banner-carousel-wrap" style="position: relative;">
            <div id="carouselExample" class="carousel slide" data-ride="carousel" data-interval="3000">
                <div class="carousel-inner">
                    <% if (Banner.length> 0) { %>
                        <% Banner.forEach((banners, index)=> { %>
                            <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                                <img src="/userimages/<%= banners.bannerImage %>" class="d-block mx-auto" alt="">
                            </div>
                            <% }) %>
                                <% } %>
                </div>
                <a class="carousel-control-prev" href="#carouselExample" role="button" data-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="sr-only">Previous</span>
                </a>
                <a class="carousel-control-next" href="#carouselExample" role="button" data-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="sr-only">Next</span>
                </a>
            </div>
        </div>
    </section>


    <section class="single_product_list">
        <div class="container">
            <div class="row justify-content-center"> <!-- Center align the cards -->
                <div class="col-lg-4 col-md-6">
                    <!-- First Product Card -->
                    <div class="card mb-4 card-with-border">
                        <img src="/images/user/maxresdefault.jpg" class="card-img" alt="#">
                        <div class="card-body card-height"> <!-- Added card-height class -->
                            <h3 class="card-title">New Exterior Painting Collections</h3>
                            <p class="card-text">Eco Paint: Recyclable, zero CO2 during
                                production.</p>
                            <a href="/products" class="btn btn-primary btn-block">Explore Now</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <!-- Second Product Card -->
                    <div class="card mb-4 card-with-border">
                        <img src="/images/user/maxresdefault-1.jpg" class="card-img" alt="#">
                        <div class="card-body card-height"> <!-- Added card-height class -->
                            <h3 class="card-title">New Wood Painting Collections</h3>
                            <p class="card-text">Hypoallergenic Paint: 100% natural,
                                safe for all indoors.</p>
                            <a href="/products" class="btn btn-primary btn-block">Explore Now</a>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 col-md-6">
                    <!-- Third Product Card -->
                    <div class="card mb-4 card-with-border">
                        <img src="/images/user/maxresdefault-2.jpg" class="card-img" alt="#">
                        <div class="card-body card-height"> <!-- Added card-height class -->
                            <h3 class="card-title">New Interior Painting Collections</h3>
                            <p class="card-text">Artisanal Paint: Handmade strokes
                                filled with passion.</p>
                            <a href="/products" class="btn btn-primary btn-block">Explore Now</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- trending item start-->
    <section class="trending_items">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="section_tittle text-center">
                        <h2>Why Our Paints ?</h2>
                    </div>
                </div>
            </div>
            <div>
                <img src="/images/user/quality.png" alt="" class="img-fluid img-hover">
            </div>
        </div>
    </section>




    <!-- trending item end-->


    <!--testimonial start-->
    <div class="container pc-testimonials">
    <div class="row">

        <div class="col-lg-4 mb-4">
            <div class="card h-100">
                <img src="/images/user/icon-5359553_1280.png" class="card-img-top ind-img" alt="John Doe">
                <div class="card-body">
                    <h5 class="card-title">John Doe</h5>
                    <div class="rating">
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                    </div>
                    <p class="card-text">"I recently used paint from this company, and I was pleasantly surprised. The color selection was fantastic, and the paint quality was top-notch. It covered my walls evenly, and I didn't need multiple coats. Highly recommended!"</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="card h-100">
                <img src="/images/user/icon-5359553_1280.png" class="card-img-top ind-img" alt="Muhammed">
                <div class="card-body">
                    <h5 class="card-title">Muhammed</h5>
                    <div class="rating">
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                    </div>
                    <p class="card-text">"I've been a loyal customer of this paint company for years, and they never disappoint. The durability of their paint is impressive. It withstands wear and tear, and the colors stay vibrant. I wouldn't choose any other brand."</p>
                </div>
            </div>
        </div>
        <div class="col-lg-4 mb-4">
            <div class="card h-100">
                <img src="/images/user/icon-5359553_1280.png" class="card-img-top ind-img" alt="Karthik shankar">
                <div class="card-body">
                    <h5 class="card-title">Karthik shankar</h5>
                    <div class="rating">
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                        <span class="star">&#9733;</span>
                    </div>
                    <p class="card-text">"I had a great experience with this paint company. The customer service was exceptional, helping me choose the perfect shade for my home. The paint itself was easy to work with, and the result was fantastic. I'm extremely satisfied with their product and support." </p>
                </div>
            </div>
        </div>

        <!-- Add similar code for other testimonials -->
    </div>
    </div>

