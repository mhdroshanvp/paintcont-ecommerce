                            </div>
                            <h1><b>Create your dream home with our Paints</b></h1>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="social_icon">
                            <h1><b>PAINTCONT</b></h1>
                            <a href="/error"><i class="fab fa-facebook-f"></i></a>
                            <a href="/error"><i class="fab fa-instagram"></i></a>
                            <a href="/error"><i class="fab fa-google-plus-g"></i></a>
                            <a href="/error"><i class="fab fa-linkedin-in"></i></a>
